---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TestimonialSimple from '../components/TestimonialSimple.astro';
import { BRAND_NAME } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, author, pubDate, updatedDate, heroImage } = Astro.props;

const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const heroImageURL = heroImage ? new URL(heroImage.src, Astro.url).toString() : undefined;

const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	...(heroImageURL && { image: heroImageURL }),
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Organization',
		name: author,
		url: Astro.site?.toString(),
	},
	publisher: {
		'@type': 'Organization',
		name: BRAND_NAME,
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageURL,
	},
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: title, item: pageURL },
	],
};
---

<html lang="en-IN">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			main {
				/* Overrides the base layer's 720px width; max-width/centering/padding
				   are handled by the Tailwind classes on the <main> element itself. */
				width: calc(100% - 2em);
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				/* Width/spacing are handled by the Tailwind classes on the element
				   itself; <main>'s max-w-4xl is the one width constraint now. */
				color: var(--foreground);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.byline {
				margin-bottom: 0.5em;
				color: var(--muted-foreground);
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="px-0 mx-auto max-w-4xl">
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose w-full px-0 mx-auto">
					<div class="title">
						<div class="byline">
							By {author} &middot; <FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
			<TestimonialSimple />
		</main>
		<Footer />
	</body>
</html>
