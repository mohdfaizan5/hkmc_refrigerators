---
// Core appliance card: image, name, visit fee, linking wherever the caller needs.
// No section heading here by design — the page/section around it owns that copy.
import { Image } from 'astro:assets';
import type { ServiceCategory } from '../data/services';

interface Props {
	service: ServiceCategory;
	href?: string;
}

const { service, href = '/#book' } = Astro.props;
---

<a
	href={href}
	class="group flex w-full flex-col rounded-2xl border-zinc-200 transition-shadow hover:shadow-lg sm:max-w-56"
>
	<div class="relative">
		<Image
			src={service.image}
			alt={service.name}
			width={256}
			height={192}
			loading="lazy"
			decoding="async"
			class="z-10 aspect-4/3 w-32 mx-auto object-cover transition-transform duration-300 group-hover:scale-105"
		/>
		<div class="absolute -top-2 left-10 -z-10 size-32 rounded-full bg-blue-500 opacity-40"></div>
	</div>
	<div class="mt-2 flex flex-1 flex-col px-0 py-5">
		<h3 class="mb-0 text-center text-lg font-semibold text-zinc-950">{service.name}</h3>
		<div class="mt-2 flex items-center justify-center">
			<span class="text-sm text-zinc-900">{service.visitFee}</span>
		</div>
	</div>
</a>
