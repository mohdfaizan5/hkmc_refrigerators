---
// Core badge list for one service's problem-keywords, each linking to a matching
// blog post where one exists, or the booking anchor otherwise. No heading here —
// the caller adds its own (e.g. the service name, or "Common problems we fix").
import { Badge } from '@/components/ui/badge';
import { problemLinks, type ServiceCategory } from '../data/services';

interface Props {
	service: ServiceCategory;
}

const { service } = Astro.props;
---

<ul class="flex flex-wrap gap-2">
	{
		service.problems.map((problem) => (
			<a href={problemLinks[problem] ?? '/#book'}>
				<Badge
					variant="outline"
					className="inline-block rounded-full border border-zinc-200 bg-white px-3 pb-2.5 text-sm text-zinc-700 transition-colors hover:border-zinc-300 hover:bg-zinc-50"
				>
					{problem}
				</Badge>
			</a>
		))
	}
</ul>
