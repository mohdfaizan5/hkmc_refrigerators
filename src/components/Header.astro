---
import { BRAND_NAME, PHONE_DISPLAY, PHONE_HREF } from '../consts';

const navLinks = [
	{ href: '/#services', label: 'Services' },
	{ href: '/#commercial', label: 'Commercial' },
	{ href: '/#areas', label: 'Areas we serve' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/about/', label: 'About' },
	{ href: '/technicians/', label: 'Technicians' },
	{ href: '/#faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 border-b border-zinc-200 bg-white/95 backdrop-blur">
	<nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:h-20 lg:px-8">
		<a href="/" class="flex shrink-0 items-baseline gap-1.5 text-lg font-bold tracking-tight text-zinc-900 lg:text-xl">
			HKMC<span class="font-normal text-zinc-500">Refrigerators</span>
		</a>

		<div class="hidden items-center gap-6 lg:flex xl:gap-8">
			{
				navLinks.map((link) => (
					<a href={link.href} class="text-sm font-medium text-zinc-700 transition-colors hover:text-zinc-950">
						{link.label}
					</a>
				))
			}
		</div>

		<div class="flex items-center gap-3">
			<a
				href={PHONE_HREF}
				class="hidden items-center gap-2 text-sm font-semibold text-zinc-900 sm:flex"
				aria-label={`Call ${BRAND_NAME} at ${PHONE_DISPLAY}`}
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
					<path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z"></path>
				</svg>
				{PHONE_DISPLAY}
			</a>
			<a
				href="/#book"
				class="rounded-full bg-zinc-900 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-zinc-700 sm:px-5 sm:py-2.5"
			>
				Book a Repair
			</a>
			<button
				id="mobile-menu-button"
				type="button"
				class="-mr-1 flex size-11 items-center justify-center rounded-md text-zinc-700 lg:hidden"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Toggle menu"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-6">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5"></path>
				</svg>
			</button>
		</div>
	</nav>

	<div id="mobile-menu" class="hidden border-t border-zinc-200 bg-white lg:hidden">
		<div class="space-y-1 px-4 py-3">
			{
				navLinks.map((link) => (
					<a href={link.href} class="block rounded-md px-2 py-2.5 text-base font-medium text-zinc-800 hover:bg-zinc-50">
						{link.label}
					</a>
				))
			}
			<a href={PHONE_HREF} class="block rounded-md px-2 py-2.5 text-base font-semibold text-zinc-950">
				Call {PHONE_DISPLAY}
			</a>
		</div>
	</div>
</header>

<script>
	const button = document.getElementById('mobile-menu-button');
	const menu = document.getElementById('mobile-menu');

	button?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('hidden') === false;
		button.setAttribute('aria-expanded', String(isOpen));
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			menu.classList.add('hidden');
			button?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
