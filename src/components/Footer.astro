---
import { BRAND_NAME, CITY, CONTACT_EMAIL, PHONE_DISPLAY, PHONE_HREF, SERVICE_HOURS } from '../consts';
import { serviceCategories } from '../data/services';

const today = new Date();
---

<footer class="border-t border-zinc-200 bg-zinc-50">
	<div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
		<div class="grid grid-cols-2 gap-10 md:grid-cols-4">
			<div class="col-span-2 md:col-span-1">
				<a href="/" class="text-lg font-bold tracking-tight text-zinc-900">
					HKMC<span class="font-normal text-zinc-500">Refrigerators</span>
				</a>
				<p class="mt-3 max-w-xs text-sm leading-6 text-zinc-600">
					Verified technicians for AC, refrigerator, washing machine and appliance repair, on-demand across
					{CITY}.
				</p>
			</div>

			<div>
				<h3 class="text-2xl font-semibold text-zinc-900">Services</h3>
				<ul class="mt-4 space-y-1">
					{
						serviceCategories.map((service) => (
							<li>
								<a href={`/services/${service.slug}/`} class="text-sm text-zinc-600 hover:text-zinc-900">
									{service.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h3 class="text-2xl font-semibold text-zinc-900">Company</h3>
				<ul class="mt-4 space-y-1">
					<li><a href="/about/" class="text-sm text-zinc-600 hover:text-zinc-900">About us</a></li>
					<li><a href="/technicians/" class="text-sm text-zinc-600 hover:text-zinc-900">Our technicians</a></li>
					<li><a href="/blog/" class="text-sm text-zinc-600 hover:text-zinc-900">Blog</a></li>
					<li><a href="/tools/" class="text-sm text-zinc-600 hover:text-zinc-900">Free Tools</a></li>
					<li><a href="/#faq" class="text-sm text-zinc-600 hover:text-zinc-900">FAQs</a></li>
					<li><a href="/#areas" class="text-sm text-zinc-600 hover:text-zinc-900">Areas we serve</a></li>
					<li><a href="/privacy-policy/" class="text-sm text-zinc-600 hover:text-zinc-900">Privacy policy</a></li>
					<li><a href="/terms-of-service/" class="text-sm text-zinc-600 hover:text-zinc-900">Terms of service</a></li>
				</ul>
			</div>

			<div>
				<h3 class="text-2xl font-semibold text-zinc-900">Get in touch</h3>
				<ul class="mt-4 space-y-1 text-sm text-zinc-600">
					<li><a href={PHONE_HREF} class="text-zinc-600 hover:text-zinc-900">{PHONE_DISPLAY}</a></li>
					<li><a href={`mailto:${CONTACT_EMAIL}`} class="text-zinc-600 hover:text-zinc-900">{CONTACT_EMAIL}</a></li>
					<li>{SERVICE_HOURS}</li>
					<li>Serving all of {CITY}, Karnataka</li>
				</ul>
			</div>
		</div>

		<div class="mt-12 flex flex-col gap-3 border-t border-zinc-200 pt-6 text-xs text-zinc-500 sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {today.getFullYear()} {BRAND_NAME}. All rights reserved.</p>
			<p>Prices, availability and service areas subject to change.</p>
		</div>
	</div>
</footer>
