---
import Star from "phosphor-astro/Star.astro";
import { getTestimonials, type Testimonial } from "../data/testimonials";

interface Props {
  testimonials?: Testimonial[];
  eyebrow?: string;
  heading?: string;
}

const {
  testimonials: items = getTestimonials(Astro.url.pathname, 3),
  eyebrow = "Customer reviews",
  heading = "What Bangalore homes say about us",
} = Astro.props;

const fallbackColor =
  "conic-gradient(from 0deg, #fbbf24, #f43f5e, #6366f1, #fbbf24)";
---

<section class="bg-background py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-6 sm:px-10">
    <div class="flex flex-col items-center gap-3 text-center">
      <span
        class="text-xs font-medium uppercase tracking-[0.18em] text-muted-foreground"
      >
        {eyebrow}
      </span>
      <h2
        class="text-balance font-semibold tracking-tight"
        style={{
          fontSize: "clamp(1.85rem, 4vw, 2.75rem)",
          letterSpacing: "-0.03em",
          lineHeight: 1.08,
        }}
      >
        {heading}
      </h2>
    </div>

    <ul class="mt-14 grid gap-4 md:grid-cols-3">
      {
        items.map((t) => (
          <li class="flex flex-col gap-4 rounded-2xl border border-border bg-card p-6 shadow-sm shadow-black/5">
            <blockquote class="text-balance text-sm leading-relaxed text-foreground">
              &ldquo;{t.review}&rdquo;
            </blockquote>
            <div class="flex items-center gap-0 text-amber-500">
              {[...Array(5)].map((_, i) => (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 36 36"
                >
                  <path
                    fill="#ffac33"
                    d="M27.287 34.627c-.404 0-.806-.124-1.152-.371L18 28.422l-8.135 5.834a1.97 1.97 0 0 1-2.312-.008a1.97 1.97 0 0 1-.721-2.194l3.034-9.792l-8.062-5.681a1.98 1.98 0 0 1-.708-2.203a1.98 1.98 0 0 1 1.866-1.363L12.947 13l3.179-9.549a1.976 1.976 0 0 1 3.749 0L23 13l10.036.015a1.975 1.975 0 0 1 1.159 3.566l-8.062 5.681l3.034 9.792a1.97 1.97 0 0 1-.72 2.194a1.96 1.96 0 0 1-1.16.379"
                  />
                </svg>
              ))}
            </div>
            <figcaption class="mt-auto flex items-center gap-3">
              {t.image ? (
                <img
                  src={t.image}
                  alt={t.author}
                  class="size-9 shrink-0 rounded-full ring-2 ring-border"
                />
              ) : (
                <span
                  aria-hidden
                  class="size-9 shrink-0 rounded-full ring-2 ring-border"
                  style={{ background: t.color ?? fallbackColor }}
                />
              )}
              <div class="flex flex-col leading-tight">
                <span class="text-sm font-medium text-foreground">
                  {t.author}
                </span>
                <span class="text-xs text-muted-foreground">{t.subtitle}</span>
              </div>
            </figcaption>
          </li>
        ))
      }
    </ul>
  </div>
</section>
