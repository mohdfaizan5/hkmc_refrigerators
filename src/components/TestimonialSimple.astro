---
import Star from "phosphor-astro/Star.astro";
import { getTestimonial, type Testimonial } from "../data/testimonials";

interface Props {
  testimonial?: Testimonial;
}

const { testimonial = getTestimonial(Astro.url.pathname) } = Astro.props;
const { review, author, subtitle, href, image } = testimonial;
const Wrapper = href ? "a" : "div";
---

<section class="bg-background py-10 sm:py-15">
  <Wrapper
    href={href}
    target={href ? "_blank" : undefined}
    rel={href ? "noopener noreferrer" : undefined}
    class="mx-auto block max-w-3xl px-6 sm:px-10"
  >
    <figure class="flex flex-col items-center gap-7 text-center">
      <div class="flex items-center gap-1 text-amber-500">
        {
          [...Array(5)].map((_, i) => (
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 36 36"
            >
              <path
                fill="#ffac33"
                d="M27.287 34.627c-.404 0-.806-.124-1.152-.371L18 28.422l-8.135 5.834a1.97 1.97 0 0 1-2.312-.008a1.97 1.97 0 0 1-.721-2.194l3.034-9.792l-8.062-5.681a1.98 1.98 0 0 1-.708-2.203a1.98 1.98 0 0 1 1.866-1.363L12.947 13l3.179-9.549a1.976 1.976 0 0 1 3.749 0L23 13l10.036.015a1.975 1.975 0 0 1 1.159 3.566l-8.062 5.681l3.034 9.792a1.97 1.97 0 0 1-.72 2.194a1.96 1.96 0 0 1-1.16.379"
              />
            </svg>
          ))
          // <Star key={i} weight="fill" class="size-4  fill-amber-400!" />
        }
      </div>

      <blockquote
        class="text-balance text-foreground"
        style={{
          fontFamily: "ui-serif, Georgia, serif",
          fontSize: "clamp(1.1rem, 5vw, 1.6rem)",
          letterSpacing: "-0.015em",
          lineHeight: 1.22,
        }}
      >
        &ldquo;{review}&rdquo;
      </blockquote>
      <figcaption class="flex items-center gap-3">
        {
          image ? (
            <img
              src={image}
              alt={author}
              class="size-11 rounded-full ring-2 ring-border"
            />
          ) : (
            <span
              aria-hidden
              class="size-11 rounded-full ring-2 ring-border"
              style={{
                background:
                  testimonial.color ??
                  "conic-gradient(from 0deg, #fbbf24, #f43f5e, #6366f1, #fbbf24)",
              }}
            />
          )
        }
        <div class="flex flex-col items-start leading-tight">
          <span class="text-sm font-medium text-foreground">
            {author}
          </span>
          {
            subtitle && (
              <span class="text-xs text-muted-foreground">{subtitle}</span>
            )
          }
        </div>
      </figcaption>
    </figure>
  </Wrapper>
</section>
