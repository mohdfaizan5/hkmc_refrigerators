---
import { Image } from "astro:assets";
import CTASimple from "@/components/CTASimple.astro";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import ServiceProblemBadges from "../../components/ServiceProblemBadges.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import {
  BRAND_NAME,
  CITY,
  CITY_FORMAL,
  PHONE_DISPLAY,
  PHONE_HREF,
} from "../../consts";
import { getService, serviceCategories, serviceFaqs } from "../../data/services";
import ServiceFAQ from "@/components/ServiceFAQ.astro";
import TestimonialSimple from "@/components/TestimonialSimple.astro";

const service = getService("ac-repair")!;
const otherServices = serviceCategories.filter((s) => s.slug !== service.slug);
const subheading =
  "Split, window and inverter AC — installation, gas refill, general service and repair, usually the same day.";

const title = `${service.name} in ${CITY} | ${BRAND_NAME}`;
const description = `Split, window and inverter AC repair in ${CITY} — installation, gas refill, general service and same-day repair. ${service.visitFee}.`;

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: service.name,
  provider: {
    "@type": "HomeAndConstructionBusiness",
    name: BRAND_NAME,
    telephone: PHONE_HREF.replace("tel:", ""),
  },
  areaServed: { "@type": "City", name: CITY_FORMAL },
  description: service.description,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Services",
      item: new URL("/services", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: service.name,
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <BaseHead title={title} description={description} image={service.image} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body class="bg-white text-zinc-900">
    <Header />
    <main>
      <!-- Hero -->
      <section
        class="mx-auto max-w-7xl px-4 pt-10 pb-14 sm:px-6 lg:px-8 lg:pt-16 lg:pb-20"
      >
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <p
              class="text-sm font-semibold tracking-wide text-zinc-500 uppercase"
            >
              Now serving {CITY}
            </p>
            <h1
              class="mt-3 text-4xl leading-[1.1] font-bold tracking-tight text-zinc-950 sm:text-5xl"
            >
              {service.name} in {CITY}
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-7 text-zinc-600">
              {subheading}
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="/#book"
                class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-zinc-700"
              >
                Book a Repair
              </a>
              <a
                href={PHONE_HREF}
                class="flex items-center gap-2 rounded-full border border-zinc-300 px-7 py-3.5 text-base font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-4"
                >
                  <path
                    d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z"
                  ></path>
                </svg>
                Call {PHONE_DISPLAY}
              </a>
            </div>
            <p class="mt-6 text-sm font-semibold text-zinc-900">
              {service.visitFee}
            </p>
          </div>
          <Image
            src={service.image}
            alt={service.name}
            width={700}
            height={500}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        </div>
      </section>

      <TrustStrip />

      <!-- Common problems -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <h2 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          Common {service.shortName} problems we fix
        </h2>
        <p class="mt-3 text-base text-zinc-600">
          Tap an issue to read more, or book a repair directly.
        </p>
        <div class="mt-8">
          <ServiceProblemBadges service={service} />
        </div>
      </section>

      <!-- Free tools -->
      <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
        <div
          class="grid gap-6 rounded-2xl border border-zinc-200 p-6 sm:grid-cols-2 sm:p-8"
        >
          <a href="/tools/ac-tonnage-calculator/" class="group">
            <h3
              class="text-lg font-semibold text-zinc-950 group-hover:underline"
            >
              Not sure what size AC you need?
            </h3>
            <p class="mt-1.5 text-sm text-zinc-600">
              Try our free AC Tonnage Calculator — enter your room size for an
              instant recommendation.
            </p>
          </a>
          <a href="/tools/ac-running-cost-calculator/" class="group">
            <h3
              class="text-lg font-semibold text-zinc-950 group-hover:underline"
            >
              Wondering what your AC is costing you?
            </h3>
            <p class="mt-1.5 text-sm text-zinc-600">
              Try our free AC Running Cost Calculator to estimate your monthly
              electricity bill.
            </p>
          </a>
        </div>
      </section>
      
      <TestimonialSimple />

      <ServiceFAQ faqs={serviceFaqs[service.slug] ?? []} />

      <!-- Other services -->
      <section class="bg-zinc-50 py-16 lg:py-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2
            class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl"
          >
            Other services we offer
          </h2>
          <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:flex lg:flex-wrap lg:gap-6">
            {
              otherServices.map((other) => (
                <ServiceCard
                  service={other}
                  href={`/services/${other.slug}/`}
                />
              ))
            }
          </div>
        </div>
      </section>

      <!-- <CTASimple
        PHONE_DISPLAY={PHONE_DISPLAY}
        PHONE_HREF={PHONE_HREF}
        CITY={CITY}
      /> -->
      <!-- Final CTA -->
      <section class="bg-zinc-950">
        <div
          class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-20"
        >
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            {service.shortName} acting up? We can be there today.
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-zinc-400">
            Verified technicians, genuine parts, transparent pricing — across {
              CITY
            }.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a
              href="/#book"
              class="rounded-full bg-white px-7 py-3.5 text-base font-semibold text-zinc-950 transition-colors hover:bg-zinc-200"
            >
              Book a Repair
            </a>
            <a
              href={PHONE_HREF}
              class="rounded-full border border-white/30 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:border-white"
            >
              Call {PHONE_DISPLAY}
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
