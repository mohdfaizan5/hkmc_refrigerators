---
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import ServiceProblemBadges from "../../components/ServiceProblemBadges.astro";
import TestimonialSimple from "../../components/TestimonialSimple.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import { getArea } from "../../data/areas";
import { getService, serviceCategories } from "../../data/services";
import {
  BRAND_NAME,
  CITY,
  CITY_FORMAL,
  CONTACT_EMAIL,
  OPENING_HOURS,
  PHONE_DISPLAY,
  PHONE_HREF,
} from "../../consts";

const area = getArea("koramangala")!;
const service = getService("ac-repair")!;
const otherServices = serviceCategories.filter((s) => s.slug !== service.slug);

const title = `AC Repair in ${area.name} | Same-Day Service | ${BRAND_NAME}`;
const description = `AC repair in ${area.name}, Bangalore — split, window and inverter AC service, gas refill and installation from verified technicians. ${service.visitFee}, 30-day warranty.`;

const areaFaqs = [
  {
    q: `How quickly can a technician reach ${area.name}?`,
    a: `We have technicians based in and around ${area.name}, so most requests booked before 4 PM get a same-day visit. You'll get a confirmation call within minutes to fix the exact slot — usually a 2-hour window rather than a fixed time.`,
  },
  {
    q: `Which parts of ${area.name} do you service?`,
    a: `We cover all of ${area.name} — from 1st Block through 8th Block, Forum Mall area, Sony World junction, Ejipura, Adugodi and the Sarjapur Road entry points. If you're in doubt, share your PIN code when booking and we'll confirm before dispatching.`,
  },
  {
    q: `What does an AC repair visit in ${area.name} cost?`,
    a: `The visit fee starts at ₹299 and covers diagnosis. You get a written quote for the repair itself before we open the unit — the visit fee is then adjusted against that quote, so there's no double-charging.`,
  },
  {
    q: `Do you service all AC brands in ${area.name}?`,
    a: `Yes — LG, Samsung, Voltas, Daikin, Blue Star, Whirlpool, Hitachi, Panasonic, IFB, Godrej, Lloyd and Mitsubishi. We use manufacturer-approved parts wherever possible, and all repairs carry a 30-day warranty on the same issue.`,
  },
  {
    q: `Can you install a new split AC in a ${area.name} apartment?`,
    a: `Yes. Installation covers wall drilling, copper piping, drainage routing, indoor-outdoor mounting and a full performance test. If your building has society approvals to obtain first, tell us at booking and we'll match the slot accordingly.`,
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: `${service.name} in ${area.name}`,
  provider: {
    "@type": "HomeAndConstructionBusiness",
    name: BRAND_NAME,
    telephone: PHONE_HREF.replace("tel:", ""),
    email: CONTACT_EMAIL,
    url: Astro.site?.toString(),
  },
  areaServed: {
    "@type": "AdministrativeArea",
    name: area.name,
    containedInPlace: {
      "@type": "City",
      name: CITY_FORMAL,
    },
  },
  description,
};

// LocalBusiness with areaServed=AdministrativeArea is the invisible signal that
// tells Google to associate this brand with searches like "AC repair Koramangala".
// Duplicated per area page on purpose — one per URL — so each area has its own
// unambiguous local-entity page.
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: BRAND_NAME,
  telephone: PHONE_HREF.replace("tel:", ""),
  email: CONTACT_EMAIL,
  priceRange: "₹₹",
  url: Astro.site?.toString(),
  address: {
    "@type": "PostalAddress",
    addressLocality: CITY_FORMAL,
    addressRegion: "Karnataka",
    addressCountry: "IN",
    ...(area.postalCodePrefix && { postalCode: area.postalCodePrefix }),
  },
  areaServed: {
    "@type": "AdministrativeArea",
    name: area.name,
    containedInPlace: {
      "@type": "City",
      name: CITY_FORMAL,
    },
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: OPENING_HOURS.opens,
    closes: OPENING_HOURS.closes,
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: areaFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".faq-answer"],
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Services",
      item: new URL("/services", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `AC Repair in ${area.name}`,
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <BaseHead title={title} description={description} image={service.image} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(serviceSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body class="bg-white text-zinc-900">
    <Header />
    <main>
      <!-- Hero -->
      <section
        class="mx-auto max-w-7xl px-4 pt-10 pb-14 sm:px-6 lg:px-8 lg:pt-16 lg:pb-20"
      >
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <nav aria-label="Breadcrumb" class="text-sm text-zinc-500">
              <a href="/" class="hover:text-zinc-900">Home</a>
              <span class="mx-2">/</span>
              <a href="/services/" class="hover:text-zinc-900">Services</a>
              <span class="mx-2">/</span>
              <span class="text-zinc-900">AC Repair in {area.name}</span>
            </nav>
            <h1
              class="mt-4 text-4xl leading-[1.1] font-extrabold tracking-tight text-zinc-950 sm:text-5xl"
            >
              AC Repair in {area.name}, Bangalore
            </h1>
            <!-- 40-60 word direct answer block, tuned for AI-Overview extraction -->
            <p class="mt-5 max-w-xl text-lg leading-7 text-zinc-600">
              {BRAND_NAME} services all AC brands and types across {area.name} —
              split, window and inverter — with verified technicians, upfront
              written quotes, and a 30-day repair warranty. Same-day visits for
              bookings placed before 4 PM. Visit fee starts at ₹299 and is
              adjusted against the final repair.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="/#book"
                class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-zinc-700"
              >
                Book a Repair
              </a>
              <a
                href={PHONE_HREF}
                class="flex items-center gap-2 rounded-full border border-zinc-300 px-7 py-3.5 text-base font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-4"
                >
                  <path
                    d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z"
                  ></path>
                </svg>
                Call {PHONE_DISPLAY}
              </a>
            </div>
            <p class="mt-6 text-sm font-semibold text-zinc-900">
              {service.visitFee} · Same-day service across {area.name}
            </p>
          </div>
          <Image
            src={service.image}
            alt={`AC repair service in ${area.name}, Bangalore`}
            width={700}
            height={500}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        </div>
      </section>

      <TrustStrip />

      <!-- Area-specific intro / coverage — this is the local proof block -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-12 lg:grid-cols-3">
          <div class="lg:col-span-2">
            <h2
              class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl"
            >
              Serving all of {area.name}
            </h2>
            <p class="mt-4 text-lg leading-7 text-zinc-600">
              {area.blurb}
            </p>
            <p class="mt-4 text-base leading-7 text-zinc-600">
              Whether it's a wall-mounted split in a 1st Block apartment, a
              window AC in an older Adugodi home, or a ductable unit at a
              Sarjapur Road office, the process is the same: a technician who
              knows your model, an upfront quote, genuine parts, and a warranty
              on the repair.
            </p>
          </div>
          <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6">
            <h3 class="text-sm font-semibold text-zinc-500 uppercase">
              Areas covered
            </h3>
            <ul class="mt-4 space-y-2 text-sm text-zinc-700">
              {area.landmarks?.map((landmark) => <li>· {landmark}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- Common problems -->
      <section
        class="mx-auto max-w-7xl border-t border-zinc-200 px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <h2 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          Common AC problems we fix in {area.name}
        </h2>
        <p class="mt-3 text-base text-zinc-600">
          Tap an issue to read more, or book a repair directly.
        </p>
        <div class="mt-8">
          <ServiceProblemBadges service={service} />
        </div>
      </section>

      <TestimonialSimple />

      <!-- Pricing snapshot — AI-extractable table for cost queries -->
      <section
        class="mx-auto max-w-7xl border-t border-zinc-200 px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <h2 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
          Indicative AC service pricing in {area.name}
        </h2>
        <p class="mt-3 max-w-2xl text-base text-zinc-600">
          Actual quotes depend on the fault, parts required, and AC type. These
          are typical ranges for common jobs — you'll always get a written quote
          before any work begins.
        </p>
        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-[520px] text-left text-sm">
            <thead class="border-b border-zinc-200 text-zinc-500 uppercase">
              <tr>
                <th class="py-3 pr-4 font-semibold">Job</th>
                <th class="py-3 pr-4 font-semibold">Typical range</th>
                <th class="py-3 font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200">
              <tr>
                <td class="py-3 pr-4 font-medium text-zinc-900">
                  Diagnostic visit
                </td>
                <td class="py-3 pr-4 text-zinc-700">₹299</td>
                <td class="py-3 text-zinc-600">
                  Adjusted against the final repair quote
                </td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-zinc-900">
                  General service (per unit)
                </td>
                <td class="py-3 pr-4 text-zinc-700">₹499 – ₹799</td>
                <td class="py-3 text-zinc-600">
                  Filter clean, coil wash, drainage check
                </td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-zinc-900">
                  Gas refill (post leak-fix)
                </td>
                <td class="py-3 pr-4 text-zinc-700">₹1,800 – ₹3,500</td>
                <td class="py-3 text-zinc-600">
                  Depends on gas type (R32 / R410A) and tonnage
                </td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-zinc-900">
                  Split AC installation
                </td>
                <td class="py-3 pr-4 text-zinc-700">₹1,500 – ₹2,500</td>
                <td class="py-3 text-zinc-600">
                  Standard piping length; extras billed per meter
                </td>
              </tr>
              <tr>
                <td class="py-3 pr-4 font-medium text-zinc-900">
                  PCB / capacitor replacement
                </td>
                <td class="py-3 pr-4 text-zinc-700">₹1,200 – ₹4,500</td>
                <td class="py-3 text-zinc-600">
                  Part cost varies by brand and model
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs text-zinc-500">
          Prices indicative, valid across {area.name} as of 2026. Full pricing
          reference on our <a href="/pricing.md" class="underline">pricing page</a>.
        </p>
      </section>

      <!-- FAQ — the extractable Q&A block that feeds AI-Overview answers -->
      <section
        id="faq"
        class="bg-zinc-50 py-16 lg:py-24"
      >
        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
          <h2
            class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl"
          >
            Frequently asked questions
          </h2>
          <div
            class="mt-8 divide-y divide-zinc-200 rounded-2xl bg-white ring-1 ring-zinc-200"
          >
            {
              areaFaqs.map((faq) => (
                <details class="group p-5 open:bg-zinc-50/60 first:rounded-t-2xl last:rounded-b-2xl">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-zinc-950">
                    {faq.q}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="size-5 shrink-0 text-zinc-500 transition-transform group-open:rotate-45"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4.5v15m7.5-7.5h-15"
                      />
                    </svg>
                  </summary>
                  <p class="faq-answer mt-3 text-sm leading-6 text-zinc-600">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Cross-link back to the general AC service page (topical cluster) -->
      <section
        class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <div
          class="flex flex-col items-start gap-6 rounded-2xl border border-zinc-200 p-8 sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <h2 class="text-xl font-semibold text-zinc-950">
              Not in {area.name}?
            </h2>
            <p class="mt-1 text-sm text-zinc-600">
              We cover all of {CITY}. See our full AC repair service overview
              for coverage areas and the complete list of what we fix.
            </p>
          </div>
          <a
            href="/services/ac-repair/"
            class="shrink-0 rounded-full border border-zinc-300 px-5 py-2.5 text-sm font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
          >
            AC Repair overview →
          </a>
        </div>
      </section>

      <!-- Final CTA -->
      <section class="bg-zinc-950">
        <div
          class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-20"
        >
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            AC acting up in {area.name}? We can be there today.
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-zinc-400">
            Verified technicians, genuine parts, transparent pricing — across {
              area.name
            } and all of {CITY}.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a
              href="/#book"
              class="rounded-full bg-white px-7 py-3.5 text-base font-semibold text-zinc-950 transition-colors hover:bg-zinc-200"
            >
              Book a Repair
            </a>
            <a
              href={PHONE_HREF}
              class="rounded-full border border-white/30 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:border-white"
            >
              Call {PHONE_DISPLAY}
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
