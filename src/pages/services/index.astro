---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import { BRAND_NAME, CITY } from '../../consts';
import { serviceCategories } from '../../data/services';

const title = `All Services | ${BRAND_NAME}`;
const description = `Every appliance and commercial refrigeration service ${BRAND_NAME} offers in ${CITY} — AC, refrigerator, washing machine, microwave, dishwasher, water purifier, water geyser and commercial refrigeration & HVAC.`;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Services', item: new URL(Astro.url.pathname, Astro.site).toString() },
	],
};
---

<!doctype html>
<html lang="en-IN">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
		</style>
	</head>
	<body class="bg-white text-zinc-900">
		<Header />
		<main>
			<section class="mx-auto max-w-7xl px-4 pt-10 pb-14 sm:px-6 lg:px-8 lg:pt-16 lg:pb-20">
				<p class="text-sm font-semibold tracking-wide text-zinc-500 uppercase">Now serving {CITY}</p>
				<h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">All services</h1>
				<p class="mt-5 max-w-2xl text-lg leading-7 text-zinc-600">
					Every appliance and commercial refrigeration service we offer in {CITY}, from home AC repair to
					restaurant cold-chain equipment. Pick one to see common problems, pricing, and book a technician.
				</p>
			</section>

			<TrustStrip />

			<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
				<div class="flex flex-wrap gap-6">
					{serviceCategories.map((service) => <ServiceCard service={service} href={`/services/${service.slug}/`} />)}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
