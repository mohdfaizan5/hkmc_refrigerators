---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import { BRAND_NAME, CITY } from "../consts";

const title = `About Us | ${BRAND_NAME}`;
const description = `${BRAND_NAME} is a technician network for AC, fridge, washing machine and appliance repair across ${CITY} — verified, upfront pricing.`;

const heroImage =
  "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWk5RQ_zi1TO6An1lLoBBz9D2UVahk-ofzPh6k1XdVk0yRiXTT-V-Sqzdyg3174znYH9sC3M12cZbRw5lHOAg4GOOcdXYf-JTZ5Xo6Y441ANw7iXTLE5A0hpwv_ysWbI9Jo0mjIwVQ=s1360-w1360-h1020-rw";
// const heroImage =
//   "https://images.unsplash.com/photo-1601659404194-97d2daca8383?auto=format&fit=crop&w=1200&h=900&q=70";

const values = [
  {
    title: "How we vet technicians",
    description:
      "Every technician goes through an ID and background check before joining our network, and is only matched to jobs on appliance types and brands they’re actually trained on — not a general-purpose referral.",
  },
  {
    title: "How pricing works",
    description:
      "A fixed visit fee covers diagnosis. You get a written quote for the repair itself before anything is opened up further, and the visit fee is adjusted against that quote — no surprise line items afterward.",
  },
  {
    title: "If something goes wrong",
    description:
      "Every repair carries a 30-day warranty on the same issue. Tell us within that window and we send someone back at no extra charge — no need to rebook or re-explain the problem from scratch.",
  },
  {
    title: "Residential and commercial",
    description:
      "Home appliances and commercial refrigeration/HVAC are handled by different technician skill sets on our network — a restaurant’s cold room gets someone experienced with commercial units, not a generalist.",
  },
];

// Every stat here must be true from day one — no track-record numbers (repair counts,
// average response times) until real operational data exists to back them up.
const stats = [
  { value: "All Brands", label: "Serviced" },
  { value: "190+", label: `Areas covered in ${CITY}` },
  { value: "₹299", label: "Starting visit fee" },
  { value: "30-Day", label: "Service warranty" },
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: BRAND_NAME,
  url: Astro.site?.toString(),
  description,
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body class="bg-white text-zinc-900">
    <Header />
    <main>
      <!-- Hero -->
      <section
        class="mx-auto max-w-7xl px-4 pt-10 pb-14 sm:px-6 lg:px-8 lg:pt-16 lg:pb-20"
      >
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <p
              class="text-sm font-semibold tracking-wide text-zinc-500 uppercase"
            >
              Who are we?
            </p>
            <h1
              class="mt-3 text-4xl leading-[1.1] font-bold tracking-tight text-zinc-950 sm:text-5xl"
            >
              Appliance repair, the way it should be
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-7 text-zinc-600">
              We built {BRAND_NAME} around a simple idea: getting an AC, fridge or
              washing machine fixed shouldn't mean guessing at prices, waiting days
              for a callback, or hoping the technician who shows up actually knows
              your appliance. Every visit — residential or commercial — comes with
              a verified technician, an upfront quote, and a warranty on the work.
            </p>
          </div>
          <img
            src={heroImage}
            alt="HKMC technician diagnosing a home appliance"
            width="1200"
            height="900"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="aspect-4/3 w-full rounded-2xl object-cover"
          />
        </div>
      </section>

      <!-- Stats -->
      <section class="border-y border-zinc-200 bg-zinc-50">
        <dl
          class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 py-10 sm:px-6 lg:grid-cols-4 lg:px-8"
        >
          {
            stats.map((stat) => (
              <div class="text-center">
                <dt class="text-3xl font-bold text-zinc-950 sm:text-4xl">
                  {stat.value}
                </dt>
                <dd class="mt-1 text-sm text-zinc-500">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </section>
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3889.805579448495!2d77.66487339999999!3d12.8558305!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae6dffd55e027f%3A0x525922b702b46dc7!2sHKMC%20REFRIGERATORS!5e0!3m2!1sen!2sin!4v1786385130001!5m2!1sen!2sin"
          class="aspect-4/3 w-full rounded-2xl border-0"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"></iframe>
      </div>
      <!-- What we do -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <div class="max-w-2xl">
          <h2
            class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl"
          >
            What we do
          </h2>
          <p class="mt-4 text-lg leading-7 text-zinc-600">
            We repair and service air conditioners, refrigerators, washing
            machines, microwaves and dishwashers for homes across {CITY}, and
            commercial refrigeration &amp; HVAC equipment — deep freezers, visi
            coolers, cold rooms and ductable AC — for restaurants, cloud
            kitchens, cafes, hospitals, hotels and offices. Whatever the
            appliance, the process is the same: a technician who knows it, an
            honest quote, and a repair backed by warranty.
          </p>
        </div>
      </section>

      <!-- Values -->
      <section id="how-we-operate" class="scroll-mt-20 bg-zinc-950 py-16 text-white lg:py-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl text-white font-bold tracking-tight sm:text-4xl">
            How we operate
          </h2>
          <div class="mt-12 grid gap-10 sm:grid-cols-2">
            {
              values.map((value) => (
                <div>
                  <h3 class="text-xl text-white font-medium">{value.title}</h3>
                  <p class="mt-2 text-base text-zinc-400">{value.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <TestimonialGrid />

      <!-- CTA -->
      <section class="bg-white">
        <div
          class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-20"
        >
          <h2
            class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl"
          >
            Have an appliance that needs attention?
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-zinc-600">
            Book a repair online or give us a call — a verified technician can
            usually be at your door the same day.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a
              href="/#book"
              class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-zinc-700"
            >
              Book a Repair
            </a>
            <a
              href="/#services"
              class="rounded-full border border-zinc-300 px-7 py-3.5 text-base font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
            >
              View Services
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
