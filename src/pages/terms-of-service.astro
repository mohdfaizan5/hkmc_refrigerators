---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { BRAND_NAME, CITY, CONTACT_EMAIL, PHONE_DISPLAY } from '../consts';

const title = `Terms of Service | ${BRAND_NAME}`;
const description = `The terms that apply when you book an appliance repair service with ${BRAND_NAME} in ${CITY}.`;

const lastUpdated = 'August 2026';
---

<!doctype html>
<html lang="en-IN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
		</style>
	</head>
	<body class="bg-white text-zinc-900">
		<Header />
		<main>
			<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
				<h1 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">Terms of Service</h1>
				<p class="mt-2 text-sm text-zinc-500">Last updated: {lastUpdated}</p>

				<div class="prose mt-8 space-y-6 text-sm leading-6 text-zinc-700">
					<p>
						These terms apply when you book a repair or service visit with {BRAND_NAME} in {CITY},
						whether through this website, by phone, or by any other channel we offer.
					</p>

					<h2 class="text-lg font-bold text-zinc-950">Booking a service</h2>
					<p>
						Submitting a booking request is a request for a service visit, not a confirmed
						appointment until we contact you to confirm a time slot. A visit fee applies for
						diagnosis, as shown on the site at the time of booking; this fee is adjusted against the
						final repair cost where a repair is carried out.
					</p>

					<h2 class="text-lg font-bold text-zinc-950">Pricing and quotes</h2>
					<p>
						You will be given a repair quote after diagnosis and before any repair work begins. Work
						proceeds only once you accept that quote. Final pricing can depend on the specific parts
						and labor required once the appliance has been inspected.
					</p>

					<h2 class="text-lg font-bold text-zinc-950">Service warranty</h2>
					<p>
						Completed repairs carry a service warranty (currently 30 days) covering a recurrence of
						the same issue. This warranty covers our workmanship; it does not cover unrelated faults,
						misuse, or damage occurring after the repair. Parts we supply may carry their own
						manufacturer warranty in addition to this.
					</p>

					<h2 class="text-lg font-bold text-zinc-950">Cancellations</h2>
					<p>
						You can cancel or reschedule a booked visit by contacting us before the technician is
						dispatched. Repeated late cancellations may affect our ability to offer priority
						scheduling for future bookings.
					</p>

					<h2 class="text-lg font-bold text-zinc-950">Your responsibilities</h2>
					<p>
						Please ensure reasonable access to the appliance and a safe working area for the
						technician, and let us know about any relevant site conditions (e.g. no elevator access,
						restricted entry timings) when booking.
					</p>

					<h2 class="text-lg font-bold text-zinc-950">Limitation of liability</h2>
					<p>
						We aim to diagnose and repair appliances accurately and safely. Except where required by
						law, we are not liable for pre-existing faults unrelated to the repair carried out, or
						for issues arising from the age or condition of the appliance itself.
					</p>

					<h2 class="text-lg font-bold text-zinc-950">Changes to these terms</h2>
					<p>
						We may update these terms from time to time; the current version will always be available
						on this page.
					</p>

					<h2 class="text-lg font-bold text-zinc-950">Contact us</h2>
					<p>
						Questions about these terms can be sent to
						<a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-zinc-950 hover:underline">
							{' '}{CONTACT_EMAIL}
						</a> or {PHONE_DISPLAY}.
					</p>

					<p class="border-t border-zinc-200 pt-6 text-xs text-zinc-400">
						This is a general terms template and has not been reviewed by a lawyer. Have it reviewed
						before relying on it for a live, transacting site.
					</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
