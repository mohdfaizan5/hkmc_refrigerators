---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { BRAND_NAME, PHONE_DISPLAY, PHONE_HREF } from '../consts';

const title = `Page Not Found | ${BRAND_NAME}`;
const description = "The page you're looking for doesn't exist — but we can still help with your appliance repair.";

const quickLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/services/', label: 'All Services' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/about/', label: 'About' },
];
---

<!doctype html>
<html lang="en-IN">
	<head>
		<BaseHead title={title} description={description} noindex />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
		</style>
	</head>
	<body class="bg-white text-zinc-900">
		<Header />
		<main>
			<section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center sm:px-6 lg:px-8 lg:py-28">
				<p class="text-sm font-semibold tracking-wide text-zinc-500 uppercase">Error 404</p>
				<p class="mt-4 text-7xl font-bold tracking-tight text-zinc-950 sm:text-8xl">404</p>
				<h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">
					This page isn't working
				</h1>
				<p class="mt-4 max-w-xl text-lg leading-7 text-zinc-600">
					The page you're looking for has been moved, renamed, or never existed. Your appliance problem,
					on the other hand, is still fixable — here's how to get back on track.
				</p>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
					<a
						href="/"
						class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-zinc-700"
					>
						Back to Homepage
					</a>
					<a
						href={PHONE_HREF}
						class="flex items-center gap-2 rounded-full border border-zinc-300 px-7 py-3.5 text-base font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
					>
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
							<path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z"></path>
						</svg>
						Call {PHONE_DISPLAY}
					</a>
				</div>

				<div class="mt-12 flex flex-wrap items-center justify-center gap-2.5 border-t border-zinc-200 pt-8">
					{
						quickLinks.map((link) => (
							<a
								href={link.href}
								class="rounded-full bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-900 hover:text-white"
							>
								{link.label}
							</a>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
