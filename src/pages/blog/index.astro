---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { BRAND_NAME, CITY } from "../../consts";

const title = `Blog | ${BRAND_NAME}`;
const description = `Appliance repair tips and maintenance guides from ${BRAND_NAME} — AC, fridge, washing machine and commercial refrigeration in ${CITY}.`;

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const abs = (path: string) => new URL(path, Astro.site).toString();

// Blog schema with a full blogPost array — gives AI agents (Perplexity, ChatGPT,
// Google's AI Mode) a machine-readable index of the site's editorial content
// beyond what the sitemap already provides. Each entry carries author/date so
// crawlers don't have to fetch each post to see freshness.
const blogSchema = {
	"@context": "https://schema.org",
	"@type": "Blog",
	name: `${BRAND_NAME} Blog`,
	description,
	url: abs(Astro.url.pathname),
	publisher: {
		"@type": "Organization",
		name: BRAND_NAME,
		url: Astro.site?.toString(),
	},
	blogPost: posts.map((post) => ({
		"@type": "BlogPosting",
		headline: post.data.title,
		description: post.data.description,
		url: abs(`/blog/${post.id}/`),
		datePublished: post.data.pubDate.toISOString(),
		dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
		author: {
			"@type": "Organization",
			name: post.data.author,
		},
	})),
};

const breadcrumbSchema = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{
			"@type": "ListItem",
			position: 1,
			name: "Home",
			item: abs("/"),
		},
		{
			"@type": "ListItem",
			position: 2,
			name: "Blog",
			item: abs(Astro.url.pathname),
		},
	],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <style>
      main {
        width: 960px;
      }
      h1 {
        margin: 0 0 1.5rem 0;
      }
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        width: calc(50% - 1rem);
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li:first-child {
        width: 100%;
        margin-bottom: 1rem;
        text-align: center;
      }
      ul li:first-child img {
        width: 100%;
      }
      ul li:first-child .title {
        font-size: 2.369rem;
      }
      ul li img {
        margin-bottom: 0.5rem;
        border-radius: 12px;
      }
      ul li a {
        display: block;
      }
      .title {
        margin: 0;
        color: var(--foreground);
        line-height: 1;
      }
      .date {
        margin: 0;
        color: var(--muted-foreground);
      }
      ul li a:hover h4,
      ul li a:hover .date {
        color: var(--primary);
      }
      ul a:hover img {
        box-shadow: var(--box-shadow);
      }
      @media (max-width: 720px) {
        ul {
          gap: 0.5em;
        }
        ul li {
          width: 100%;
          text-align: center;
        }
        ul li:first-child {
          margin-bottom: 0;
        }
        ul li:first-child .title {
          font-size: 1.563em;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        <h1>Blog</h1>
        <ul>
          {
            posts.map((post) => (
              <li class="mb-4">
                <a href={`/blog/${post.id}/`}>
                  {post.data.heroImage && (
                    <Image
                      width={720}
                      height={360}
                      src={post.data.heroImage}
                      alt={post.data.title}
                    />
                  )}
                  <h2 class="title text-xl text-left px-1.5">{post.data.title}</h2>
                  <p class="date text-xs text-left px-2">
                    <FormattedDate date={post.data.pubDate} />
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
