---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TestimonialSimple from '../../components/TestimonialSimple.astro';
import { BRAND_NAME, CITY } from '../../consts';
import { tools } from '../../data/tools';

const title = `Free Appliance Tools & Calculators | ${BRAND_NAME}`;
const description = `Free calculators for ${CITY} homes — figure out your AC size, estimate running costs, and decide whether to repair or replace an appliance. No signup needed.`;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Tools', item: new URL(Astro.url.pathname, Astro.site).toString() },
	],
};
---

<!doctype html>
<html lang="en-IN">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
		</style>
	</head>
	<body class="bg-white text-zinc-900">
		<Header />
		<main>
			<section class="mx-auto max-w-7xl px-4 pt-10 pb-14 sm:px-6 lg:px-8 lg:pt-16 lg:pb-20">
				<p class="text-sm font-semibold tracking-wide text-zinc-500 uppercase">Now serving {CITY}</p>
				<h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">Free tools</h1>
				<p class="mt-5 max-w-2xl text-lg leading-7 text-zinc-600">
					Quick calculators to help you make appliance decisions — no signup, no email required.
				</p>
			</section>

			<section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24">
				<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
					{
						tools.map((tool) => (
							<a
								href={`/tools/${tool.slug}/`}
								class="flex flex-col rounded-2xl border border-zinc-200 p-6 transition-shadow hover:shadow-lg"
							>
								<h2 class="text-lg font-semibold text-zinc-950">{tool.name}</h2>
								<p class="mt-1.5 flex-1 text-sm text-zinc-600">{tool.description}</p>
								<span class="mt-4 text-sm font-semibold text-zinc-900 group-hover:underline">
									Try it →
								</span>
							</a>
						))
					}
				</div>
			</section>

			<TestimonialSimple />
		</main>
		<Footer />
	</body>
</html>
