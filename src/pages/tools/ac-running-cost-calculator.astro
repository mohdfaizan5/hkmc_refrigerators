---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import TestimonialSimple from '../../components/TestimonialSimple.astro';
import { BRAND_NAME, CITY, PHONE_DISPLAY, PHONE_HREF } from '../../consts';
import { getTool, tools } from '../../data/tools';

const tool = getTool('ac-running-cost-calculator')!;
const otherTools = tools.filter((t) => t.slug !== tool.slug);

const title = `${tool.name} — Estimate Your Monthly AC Bill | ${BRAND_NAME}`;
const description = `Free AC electricity cost calculator. Enter your AC's tonnage, star rating, daily usage and tariff to estimate your monthly running cost in ${CITY}.`;

const faqs = [
	{
		q: 'How much electricity does a 1.5 ton AC use per hour?',
		a: 'A 5-star 1.5 ton inverter AC typically draws around 0.95 kW per hour, a 4-star around 1.1 kW, and a 3-star around 1.25 kW — actual consumption varies by brand, room load, and outdoor temperature.',
	},
	{
		q: 'Does a dirty filter increase my AC electricity bill?',
		a: "Yes, significantly. A clogged filter or dirty coil forces the compressor to work harder and run longer to reach the same temperature, which can increase running cost by 10-15% or more — one of the reasons routine service pays for itself.",
	},
	{
		q: 'Is a 5-star AC really worth the extra upfront cost?',
		a: 'Usually, if you run the AC for several hours a day for most of the year. The efficiency difference between a 3-star and 5-star unit compounds over each cooling season — use this calculator with both star ratings to compare your specific savings.',
	},
];

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: tool.name, item: new URL(Astro.url.pathname, Astro.site).toString() },
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.q,
		acceptedAnswer: { '@type': 'Answer', text: faq.a },
	})),
};
---

<!doctype html>
<html lang="en-IN">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}
		</style>
	</head>
	<body class="bg-white text-zinc-900">
		<Header />
		<main>
			<!-- Hero -->
			<section class="mx-auto max-w-3xl px-4 pt-10 pb-8 text-center sm:px-6 lg:px-8 lg:pt-16">
				<p class="text-sm font-semibold tracking-wide text-zinc-500 uppercase">Free tool</p>
				<h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">
					AC Running Cost Calculator
				</h1>
				<p class="mx-auto mt-5 max-w-xl text-lg leading-7 text-zinc-600">
					Estimate what your AC is really costing you every month.
				</p>
			</section>

			<!-- Calculator -->
			<section class="mx-auto max-w-2xl px-4 pb-16 sm:px-6 lg:px-8">
				<div class="rounded-2xl border border-zinc-200 p-6 sm:p-8">
					<div class="grid gap-5 sm:grid-cols-2">
						<div>
							<label for="tonnage" class="text-sm font-medium text-zinc-800">AC tonnage</label>
							<select
								id="tonnage"
								class="mt-1.5 block w-full rounded-lg border border-zinc-300 bg-white px-3.5 py-2.5 text-sm text-zinc-900 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 focus:outline-none"
							>
								<option value="1">1 Ton</option>
								<option value="1.5" selected>1.5 Ton</option>
								<option value="2">2 Ton</option>
							</select>
						</div>
						<div>
							<label for="star" class="text-sm font-medium text-zinc-800">Star rating</label>
							<select
								id="star"
								class="mt-1.5 block w-full rounded-lg border border-zinc-300 bg-white px-3.5 py-2.5 text-sm text-zinc-900 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 focus:outline-none"
							>
								<option value="5">5 Star</option>
								<option value="4" selected>4 Star</option>
								<option value="3">3 Star</option>
							</select>
						</div>
						<div>
							<label for="hours" class="text-sm font-medium text-zinc-800">Hours used per day</label>
							<input
								type="number"
								id="hours"
								min="1"
								max="24"
								value="8"
								class="mt-1.5 block w-full rounded-lg border border-zinc-300 px-3.5 py-2.5 text-sm text-zinc-900 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 focus:outline-none"
							/>
						</div>
						<div>
							<label for="tariff" class="text-sm font-medium text-zinc-800">Tariff (₹ per unit)</label>
							<input
								type="number"
								id="tariff"
								min="1"
								step="0.1"
								value="8"
								class="mt-1.5 block w-full rounded-lg border border-zinc-300 px-3.5 py-2.5 text-sm text-zinc-900 focus:border-zinc-900 focus:ring-1 focus:ring-zinc-900 focus:outline-none"
							/>
							<p class="mt-1 text-xs text-zinc-500">Check your latest electricity bill for the exact rate.</p>
						</div>
					</div>
					<button
						id="calculate-btn"
						type="button"
						class="mt-6 w-full rounded-full bg-zinc-900 px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-zinc-700"
					>
						Calculate running cost
					</button>

					<div id="result" class="mt-6 hidden grid grid-cols-1 gap-4 rounded-xl bg-zinc-50 p-5 text-center sm:grid-cols-3">
						<div>
							<p class="text-xs font-medium text-zinc-500 uppercase">Per day</p>
							<p id="result-daily" class="mt-1 text-xl font-bold text-zinc-950"></p>
						</div>
						<div>
							<p class="text-xs font-medium text-zinc-500 uppercase">Units / month</p>
							<p id="result-units" class="mt-1 text-xl font-bold text-zinc-950"></p>
						</div>
						<div>
							<p class="text-xs font-medium text-zinc-500 uppercase">Est. cost / month</p>
							<p id="result-cost" class="mt-1 text-xl font-bold text-zinc-950"></p>
						</div>
					</div>
				</div>

				<div class="mt-8">
					<a
						href="/services/ac-repair/"
						class="block rounded-full bg-zinc-900 px-6 py-3.5 text-center text-base font-semibold text-white transition-colors hover:bg-zinc-700"
					>
						Book AC Service — a dirty filter or low gas can raise your bill
					</a>
				</div>
			</section>

			<!-- How it works -->
			<section class="mx-auto max-w-2xl px-4 pb-16 sm:px-6 lg:px-8">
				<h2 class="text-xl font-bold text-zinc-950">How this is calculated</h2>
				<p class="mt-3 text-sm leading-6 text-zinc-600">
					We use typical power-draw figures for inverter split ACs by tonnage and star rating (for
					example, a 1.5 ton 4-star unit draws roughly 1.1 kW). Daily units are hours used × kW; monthly
					units are daily units × 30; monthly cost is units × your tariff. Actual consumption varies by
					brand, model, outdoor temperature, and appliance condition — a poorly maintained AC can use
					noticeably more.
				</p>
			</section>

			<!-- FAQ -->
			<section class="bg-zinc-50 py-16 lg:py-24">
				<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
					<h2 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">Frequently asked questions</h2>
					<div class="mt-8 divide-y divide-zinc-200 rounded-2xl bg-white ring-1 ring-zinc-200">
						{
							faqs.map((faq) => (
								<details class="group p-5 open:bg-zinc-50/60 first:rounded-t-2xl last:rounded-b-2xl">
									<summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-zinc-950">
										{faq.q}
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											class="size-5 shrink-0 text-zinc-500 transition-transform group-open:rotate-45"
										>
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
										</svg>
									</summary>
									<p class="mt-3 text-sm leading-6 text-zinc-600">{faq.a}</p>
								</details>
							))
						}
					</div>
				</div>
			</section>

			<!-- Other tools -->
			<section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
				<h2 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl">More free tools</h2>
				<div class="mt-8 grid gap-6 sm:grid-cols-2">
					{
						otherTools.map((other) => (
							<a
								href={`/tools/${other.slug}/`}
								class="rounded-2xl border border-zinc-200 p-6 transition-shadow hover:shadow-lg"
							>
								<h3 class="text-lg font-semibold text-zinc-950">{other.name}</h3>
								<p class="mt-1.5 text-sm text-zinc-600">{other.description}</p>
							</a>
						))
					}
				</div>
			</section>

			<!-- Final CTA -->
			<section class="bg-zinc-950">
				<div class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-20">
					<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Bill looking high? Get it checked.</h2>
					<p class="mx-auto mt-3 max-w-xl text-zinc-400">
						Verified technicians, genuine parts, transparent pricing — across {CITY}.
					</p>
					<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
						<a
							href="/#book"
							class="rounded-full bg-white px-7 py-3.5 text-base font-semibold text-zinc-950 transition-colors hover:bg-zinc-200"
						>
							Book a Repair
						</a>
						<a
							href={PHONE_HREF}
							class="rounded-full border border-white/30 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:border-white"
						>
							Call {PHONE_DISPLAY}
						</a>
					</div>
				</div>
			</section>
			<TestimonialSimple />
		</main>
		<Footer />

		<script>
			// kW draw by [tonnage][star]
			const powerTable: Record<string, Record<string, number>> = {
				'1': { '5': 0.65, '4': 0.75, '3': 0.85 },
				'1.5': { '5': 0.95, '4': 1.1, '3': 1.25 },
				'2': { '5': 1.25, '4': 1.45, '3': 1.65 },
			};

			const tonnageSelect = document.getElementById('tonnage') as HTMLSelectElement;
			const starSelect = document.getElementById('star') as HTMLSelectElement;
			const hoursInput = document.getElementById('hours') as HTMLInputElement;
			const tariffInput = document.getElementById('tariff') as HTMLInputElement;
			const calculateBtn = document.getElementById('calculate-btn');
			const result = document.getElementById('result');
			const resultDaily = document.getElementById('result-daily');
			const resultUnits = document.getElementById('result-units');
			const resultCost = document.getElementById('result-cost');

			calculateBtn?.addEventListener('click', () => {
				const kw = powerTable[tonnageSelect.value]?.[starSelect.value] ?? 1;
				const hours = parseFloat(hoursInput.value) || 0;
				const tariff = parseFloat(tariffInput.value) || 0;

				const dailyUnits = kw * hours;
				const monthlyUnits = dailyUnits * 30;
				const monthlyCost = monthlyUnits * tariff;

				if (resultDaily) resultDaily.textContent = `${dailyUnits.toFixed(1)} units`;
				if (resultUnits) resultUnits.textContent = `${monthlyUnits.toFixed(0)} units`;
				if (resultCost) resultCost.textContent = `₹${monthlyCost.toFixed(0)}`;
				result?.classList.remove('hidden');
			});
		</script>
	</body>
</html>
