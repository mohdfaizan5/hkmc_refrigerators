---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import TestimonialGrid from "../components/TestimonialGrid.astro";
import nadeemPhoto from "../assets/technicians/nadeem.png";
import nisarPhoto from "../assets/technicians/nisar.png";
import farooqPhoto from "../assets/technicians/farooq.png";
import { BRAND_NAME, CITY, PHONE_DISPLAY, PHONE_HREF } from "../consts";

const title = `Our Technicians | ${BRAND_NAME}`;
const description = `Meet the verified technicians behind ${BRAND_NAME} — ID-checked, background-verified, and matched to the appliances they're actually trained on across ${CITY}.`;

const technicians = [
  {
    name: "Nadeem",
    role: "Technician, HKMC Refrigerators",
    image: nadeemPhoto,
  },
  {
    name: "Nisar",
    role: "Technician, HKMC Refrigerators",
    image: nisarPhoto,
  },
  {
    name: "Farooq",
    role: "Technician, HKMC Refrigerators",
    image: farooqPhoto,
  }
];

const standards = [
  {
    title: "ID & background verified",
    description:
      "Every technician on our network goes through an ID and background check before they're allowed to take a single booking.",
  },
  {
    title: "Matched to the job",
    description:
      "We send a technician trained on your specific appliance and brand — not a generalist hoping to figure it out on-site.",
  },
  {
    title: "Upfront, written quotes",
    description:
      "You see the repair quote before any work starts. The visit fee is adjusted against it, so there's nothing sprung on you afterward.",
  },
  {
    title: "30-day warranty on the work",
    description:
      "If the same issue comes back within 30 days, we send someone back at no extra charge — no rebooking, no re-explaining.",
  },
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Our Technicians",
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <BaseHead title={title} description={description} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body class="bg-white text-zinc-900">
    <Header />
    <main>
      <!-- Hero -->
      <section
        class="mx-auto max-w-7xl px-4 pt-10 pb-14 sm:px-6 lg:px-8 lg:pt-16 lg:pb-20"
      >
        <div class="max-w-2xl">
          <p
            class="text-sm font-semibold tracking-wide text-zinc-500 uppercase"
          >
            The people behind the repairs
          </p>
          <h1
            class="mt-3 text-4xl leading-[1.1] font-bold tracking-tight text-zinc-950 sm:text-5xl"
          >
            Meet our technicians
          </h1>
          <p class="mt-5 text-lg leading-7 text-zinc-600">
            {BRAND_NAME} isn't a call center that dispatches whoever's free —
            it's a small, verified team of technicians who show up, diagnose
            the problem honestly, and stand behind the repair. Here's who
            you'll actually meet at your door across {CITY}.
          </p>
        </div>
      </section>

      <!-- Team grid -->
      <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            technicians.map((tech) => (
              <div class="overflow-hidden rounded-2xl border-zinc-200">
                <Image
                  src={tech.image}
                  alt={`${tech.name}, ${tech.role}`}
                  width={480}
                  height={480}
                  loading="eager"
                  decoding="async"
                  class="aspect-square w-full object-cover"
                />
                <div class="p-5 mx-auto">
                  <h2 class="text-lg font-semibold text-zinc-950">
                    {tech.name}
                  </h2>
                  <p class="-mt-0.5 text-sm text-zinc-600">{tech.role}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Standards -->
      <section class="bg-zinc-950 py-16 text-white lg:py-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2
            class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
          >
            What every technician on our network commits to
          </h2>
          <div class="mt-12 grid gap-10 sm:grid-cols-2">
            {
              standards.map((standard) => (
                <div>
                  <h3 class="text-xl font-medium text-white">
                    {standard.title}
                  </h3>
                  <p class="mt-2 text-base text-zinc-400">
                    {standard.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <TestimonialGrid
        eyebrow="Real reviews"
        heading="Trusted by homes across Bangalore"
      />

      <!-- Final CTA -->
      <section class="bg-zinc-50">
        <div
          class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 lg:px-8 lg:py-20"
        >
          <h2
            class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl"
          >
            Ready to get your appliance fixed?
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-zinc-600">
            Book online or call — one of our verified technicians can usually
            be at your door the same day.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a
              href="/#book"
              class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-zinc-700"
            >
              Book a Repair
            </a>
            <a
              href={PHONE_HREF}
              class="rounded-full border border-zinc-300 px-7 py-3.5 text-base font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
            >
              Call {PHONE_DISPLAY}
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
