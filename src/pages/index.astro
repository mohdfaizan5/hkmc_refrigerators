---
import { Image } from "astro:assets";
import nadeemPhoto from "../assets/technicians/nadeem.png";
import nisarPhoto from "../assets/technicians/nisar.png";
import farooqPhoto from "../assets/technicians/farooq.png";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ServiceProblemBadges from "../components/ServiceProblemBadges.astro";
import TestimonialSimple from "../components/TestimonialSimple.astro";
import TrustStrip from "../components/TrustStrip.astro";
import {
  BRAND_NAME,
  CITY,
  CITY_FORMAL,
  CONTACT_EMAIL,
  OPENING_HOURS,
  PHONE_DISPLAY,
  PHONE_HREF,
  SERVICE_HOURS,
  SITE_DESCRIPTION,
  SITE_TITLE,
} from "../consts";
import { areas } from "../data/areas";
import { serviceCategories } from "../data/services";

const heroImages = [
  {
    src: "nadeem-hkmc.png",
    alt: "HKMC technicians servicing outdoor AC units on a rooftop",
  },
  {
    src: "https://images.unsplash.com/photo-1721613877687-c9099b698faa?auto=format&fit=crop&w=600&h=430&q=70",
    alt: "Technician repairing a home refrigerator",
  },
  {
    src: "https://images.unsplash.com/photo-1610557892470-55d9e80c0bce?auto=format&fit=crop&w=600&h=430&q=70",
    alt: "Technician servicing a front-load washing machine",
  },
  {
    src: "https://images.unsplash.com/photo-1599083549933-838ea352c1cc?auto=format&fit=crop&w=600&h=430&q=70",
    alt: "Modern kitchen microwave and appliances",
  },
];

const steps = [
  {
    title: "Book online or call",
    description:
      "Tell us the appliance, the issue and your area — takes under a minute.",
  },
  {
    title: "Technician visits & diagnoses",
    description:
      "A verified technician arrives, inspects the appliance and shares an upfront quote.",
  },
  {
    title: "Repair, tested, warrantied",
    description:
      "We fix it on the spot where possible and back it with a 30-day warranty.",
  },
];

// Every stat here must be true from day one — no track-record numbers (repair counts,
// average response times) until real operational data exists to back them up.
const stats = [
  { value: "All Brands", label: "Serviced" },
  { value: "190+", label: `Areas covered in ${CITY}` },
  { value: "₹299", label: "Starting visit fee" },
  { value: "30-Day", label: "Service warranty" },
];

// Now driven by the shared areas list — chips with a live area page become
// links, ones without stay as text (so we're not shipping 404s).
const neighborhoods = areas;

const faqs = [
  {
    q: `Which appliances do you repair in ${CITY}?`,
    a: "We repair air conditioners, refrigerators, washing machines, microwaves, dishwashers, water purifiers and water geysers, plus commercial refrigeration & HVAC equipment for businesses. Beyond repairs, we also handle installation, uninstallation and general/preventive service for most of these.",
  },
  {
    q: "How fast can a technician reach me?",
    a: `Book online or call us directly, and most requests in ${CITY} get a technician visit the same day — you'll get a confirmation call to arrange the exact slot rather than a fixed time window upfront.`,
  },
  {
    q: "Do you offer a warranty on repairs?",
    a: "Yes — every repair carries a 30-day service warranty on the same issue. If it recurs within that window, we send a technician back at no extra charge, and genuine parts carry the manufacturer's own part warranty on top of that.",
  },
  {
    q: "Do you repair all brands?",
    a: "Yes. Our technicians service all major brands, including LG, Samsung, Whirlpool, Voltas, Godrej, IFB, Bosch and Daikin, and we use manufacturer-approved parts wherever possible rather than generic substitutes.",
  },
  {
    q: "What does a visit cost?",
    a: "Visit charges start from ₹299 for home appliances and ₹499 for commercial equipment. This covers diagnosis; the visit fee is then adjusted against the final repair quote, and you'll see that full estimate before any repair work begins — no obligation to proceed if you'd rather not.",
  },
  {
    q: "Do you work with restaurants, offices and other businesses?",
    a: "Yes — we service restaurants, cloud kitchens, cafes, supermarkets, hospitals, hotels and offices, covering equipment like deep freezers, visi coolers, cold rooms and ductable AC, including AMC (annual maintenance contract) plans for ongoing upkeep.",
  },
];

const heroOgImage = heroImages[0].src;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: BRAND_NAME,
  image: heroOgImage,
  telephone: PHONE_HREF.replace("tel:", ""),
  email: CONTACT_EMAIL,
  priceRange: "₹₹",
  url: Astro.site?.toString(),
  address: {
    "@type": "PostalAddress",
    addressLocality: CITY_FORMAL,
    addressRegion: "Karnataka",
    addressCountry: "IN",
  },
  areaServed: {
    "@type": "City",
    name: CITY_FORMAL,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: OPENING_HOURS.opens,
    closes: OPENING_HOURS.closes,
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.a,
    },
  })),
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".faq-answer"],
  },
};

// WebSite schema — declares the site as an entity for Google Knowledge Graph
// and gives AI agents an unambiguous root entity to attach the Organization,
// blog, and services to. Explicitly marks no on-site search endpoint via a
// SearchAction pointing at the booking flow — voice assistants that ask "search
// HKMC for X" will land at /#book, which is genuinely the primary intent path
// on this site (we don't have on-site search).
const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: BRAND_NAME,
  alternateName: "HKMC",
  url: Astro.site?.toString(),
  inLanguage: "en-IN",
  publisher: {
    "@type": "Organization",
    name: BRAND_NAME,
  },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${Astro.site?.toString()}?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: `How to book an appliance repair with ${BRAND_NAME}`,
  description: `The process for booking and completing a repair visit in ${CITY}.`,
  step: steps.map((step) => ({
    "@type": "HowToStep",
    name: step.title,
    text: step.description,
  })),
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      image={heroOgImage}
    />
    <!-- Bing Webmaster Tools site verification -->
    <meta name="msvalidate.01" content="D8C974E396695EB016C6C683C17A5E85" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(webSiteSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>

  <body class="bg-white text-zinc-900">
    <Header />
    <main class="max-w-[100vw] overflow-hidden">
      <!-- Hero -->
      <section
        class="mx-auto max-w-7xl px-4 pt-10 pb-14 sm:px-6 lg:px-8 lg:pt-16 lg:pb-20"
      >
        <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <p
              class="text-sm font-semibold tracking-wide text-zinc-500 uppercase"
            >
              Now serving {CITY}
            </p>
            <h1
              class="mt-3 text-4xl leading-[1.1] font-bold tracking-tight text-zinc-950 sm:text-5xl lg:text-[3.25rem]"
            >
              AC, fridge &amp; appliance repair at your doorstep in {CITY}
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-7 text-zinc-600">
              Verified technicians for air conditioners, refrigerators, washing
              machines, microwaves, dishwashers and commercial refrigeration.
              Transparent pricing, genuine parts, 30-day warranty.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href="#book"
                class="rounded-full bg-zinc-900 px-7 py-3.5 text-base font-semibold text-white transition-colors hover:bg-zinc-700"
              >
                Book a Repair
              </a>
              <a
                href={PHONE_HREF}
                class="flex items-center gap-2 rounded-full border border-zinc-300 px-7 py-3.5 text-base font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-4"
                >
                  <path
                    d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z"
                  ></path>
                </svg>
                Call {PHONE_DISPLAY}
              </a>
            </div>
            <dl class="mt-10 flex flex-wrap gap-x-6 gap-y-4">
              {
                stats.slice(0, 3).map((stat) => (
                  <div>
                    <dt class="text-xl md:text-2xl text-center font-bold text-zinc-950">
                      {stat.value}
                    </dt>
                    <dd class="text-xs sm:text-sm max-w-32 text-center text-zinc-500">
                      {stat.label}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div class="grid grid-cols-3 gap-3 sm:gap-4">
            <img
              src={heroImages[0].src}
              alt={heroImages[0].alt}
              width="700"
              height="500"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="col-span-3 aspect-square w-full rounded-2xl object-cover sm:aspect-4/3"
            />
            {
              heroImages
                .slice(1)
                .map((img) => (
                  <img
                    src={img.src}
                    alt={img.alt}
                    width="450"
                    height="350"
                    loading="lazy"
                    decoding="async"
                    class="aspect-4/3 w-full rounded-2xl object-cover"
                  />
                ))
            }
          </div>
        </div>
      </section>

      <TrustStrip />

      <!-- Meet the team (trust signal) -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div
          class="flex flex-col items-center gap-8 rounded-3xl border border-zinc-200 bg-zinc-50 px-6 py-10 text-center sm:flex-row sm:justify-between sm:gap-10 sm:px-10 sm:text-left"
        >
          <div class="flex -space-x-4">
            <Image
              src={nadeemPhoto}
              alt="Nadeem, HKMC technician"
              width={80}
              height={80}
              loading="lazy"
              decoding="async"
              class="size-16 rounded-full border-4 border-white object-cover shadow-sm sm:size-20"
            />
            <Image
              src={farooqPhoto}
              alt="Farooq, HKMC technician"
              width={80}
              height={80}
              loading="lazy"
              decoding="async"
              class="size-16 rounded-full border-4 border-white object-cover shadow-sm sm:size-20"
            />
            <Image
              src={nisarPhoto}
              alt="Nisar, HKMC technician"
              width={80}
              height={80}
              loading="lazy"
              decoding="async"
              class="size-16 rounded-full border-4 border-white object-cover shadow-sm sm:size-20"
            />
          </div>
          <div class="max-w-xl">
            <h2 class="text-xl font-bold text-zinc-950 sm:text-2xl">
              These are the technicians who'll show up
            </h2>
            <p class="mt-2 text-sm text-zinc-600 sm:text-base">
              A small, verified team — not a call-center dispatch. Every visit
              across {CITY} is handled by one of them, matched to the appliance they're
              trained on.
            </p>
          </div>
          <a
            href="/technicians/"
            class="shrink-0 rounded-full border border-zinc-300 bg-white px-5 py-2.5 text-sm font-semibold text-zinc-900 transition-colors hover:border-zinc-900"
          >
            Meet the team
          </a>
        </div>
      </section>

      <!-- Services -->
      <section
        id="services"
        class="mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <div class="max-w-2xl">
          <h2 class="text-4xl font-bold text-zinc-950 sm:text-5xl">
            Book a repair by appliance
          </h2>
          <p class="mt-3 text-base text-zinc-600">
            Pick the appliance that needs attention. Every visit includes
            diagnosis, an upfront quote and a 30-day warranty on the repair.
          </p>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-6 sm:grid-cols-2 lg:grid-cols-6">
          {
            serviceCategories.map((service) => (
              <ServiceCard
                service={service}
                href={`/services/${service.slug}/`}
              />
            ))
          }
        </div>
      </section>

      <!-- How it works -->
      <section class="bg-zinc-950 py-16 text-white lg:py-24">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-bold text-white tracking-tight sm:text-4xl">
            How it works
          </h2>
          <div class="mt-12 grid gap-10 sm:grid-cols-3 sm:gap-8">
            {
              steps.map((step, index) => (
                <div>
                  <div class="flex md:flex-col items-baseline gap-4">
                    <span class="flex size-8 md:size-11 items-center justify-center rounded-full bg-white text-lg font-bold text-zinc-950">
                      {index + 1}
                    </span>
                    <h3 class="mt-5 text-zinc-50 text-xl md:text-xl font-medium md:mt-0">
                      {step.title}
                    </h3>
                  </div>
                  <p class="text-base ml-12 md:ml-0 text-zinc-400">
                    {step.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Common problems -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <div class="max-w-2xl">
          <h2
            class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-950 sm:text-4xl"
          >
            Common problems we fix
          </h2>
          <p class="mt-3 text-base text-zinc-600">
            Not sure what's wrong? These are the issues our technicians see —
            and fix — most often.
          </p>
        </div>
        <div
          class="mt-10 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            serviceCategories.map((service) => (
              <div>
                <h3 class="text-xl font-semibold text-zinc-950">
                  <a
                    href={`/services/${service.slug}/`}
                    class="hover:underline"
                  >
                    {service.name}
                  </a>
                </h3>
                <div class="mt-3">
                  <ServiceProblemBadges service={service} />
                </div>
              </div>
            ))
          }
        </div>
      </section>
      <section class="mx-auto max-w-7xl px-4 pb-16 flex items-center justify-between">
        <p>We provide quality-assured services across {CITY}.</p>
        <div class="size-20 ">
          <img
            src="quality-assured-hkmc.png"
            alt="Technician repairing a home refrigerator"
            width="200"
            height="200"
            loading="lazy"
            decoding="async"
            class="w-full object-cover "
          />
        </div>
      </section>
      <!-- Commercial banner -->
      <section id="commercial" class="scroll-mt-20 px-4 sm:px-6 lg:px-8">
        <div
          class="relative mx-auto max-w-7xl h-64 md:h-auto overflow-hidden rounded-3xl"
        >
          <img
            src="https://images.unsplash.com/photo-1762924352150-12b8c19bf4d6?auto=format&fit=crop&w=1600&h=800&q=65"
            alt="Commercial kitchen refrigeration equipment"
            width="1600"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-[420px] w-full object-cover sm:h-[380px]"
          />
          <div
            class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-transparent"
          >
          </div>
          <div class="absolute inset-0 flex items-center">
            <div class="max-w-lg px-6 py-10 sm:px-12">
              <!-- <span
                class="inline-block rounded-full bg-white px-3 py-1 text-xs font-bold tracking-wide text-zinc-950 uppercase"
              >
                For businesses
              </span> -->
              <h2
                class="mt-4 text-3xl md:text-5xl font-bold tracking-tight text-white sm:text-4xl"
              >
                Commercial refrigeration &amp; HVAC, handled
              </h2>
              <p class="mt-3 text-sm shadow-2xl md:text-base text-white/85">
                Deep freezers, visi coolers, cold rooms and ductable AC for
                restaurants, cloud kitchens, cafes, hospitals and offices — with
                AMC plans for zero-downtime operations.
              </p>
              <a
                href="#book"
                class="mt-6 inline-block rounded-full bg-white px-6 py-3 text-sm font-semibold text-zinc-950 transition-colors hover:bg-zinc-200"
              >
                Get a business quote
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-24">
        <dl
          class="grid grid-cols-2 gap-8 border-y border-zinc-200 py-10 sm:grid-cols-4"
        >
          {
            stats.map((stat) => (
              <div class="text-center">
                <dt class="text-3xl font-bold text-zinc-950 sm:text-4xl">
                  {stat.value}
                </dt>
                <dd class="mt-1 text-sm text-zinc-500">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Service area -->
      <section
        id="areas"
        class="mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <h2 class="text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">
          Areas we serve in {CITY}
        </h2>
        <p class="mt-3 max-w-2xl text-base text-zinc-600">
          HKMC Refrigerators currently covers all of {CITY}, with technicians
          based across these neighborhoods for faster response times.
        </p>
        <ul class="mt-8 flex flex-wrap gap-2.5">
          {
            neighborhoods.map((area) => (
              <li>
                {area.hasAreaPage ? (
                  <a
                    href={`/services/ac-repair-in-${area.slug}/`}
                    class="inline-block rounded-full bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-200 hover:text-zinc-950"
                  >
                    {area.name}
                  </a>
                ) : (
                  <span class="inline-block rounded-full bg-zinc-100 px-4 py-2 text-sm font-medium text-zinc-700">
                    {area.name}
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- FAQ -->
      <section id="faq" class="bg-zinc-50 py-16 lg:py-24">
        <div class="mx-auto max-w-3xl scroll-mt-20 px-4 sm:px-6 lg:px-8">
          <h2
            class="text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl"
          >
            Frequently asked questions
          </h2>
          <div
            class="mt-8 divide-y divide-zinc-200 rounded-2xl bg-white ring-1 ring-zinc-200"
          >
            {
              faqs.map((faq) => (
                <details class="group p-5 open:bg-zinc-50/60 first:rounded-t-2xl last:rounded-b-2xl">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-semibold text-zinc-950">
                    {faq.q}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      class="size-5 shrink-0 text-zinc-500 transition-transform group-open:rotate-45"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 4.5v15m7.5-7.5h-15"
                      />
                    </svg>
                  </summary>
                  <p class="faq-answer mt-3 text-sm leading-6 text-zinc-600">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <TestimonialSimple />

      <!-- Booking form -->
      <section
        id="book"
        class="mx-auto max-w-7xl scroll-mt-20 px-4 py-16 sm:px-6 lg:px-8 lg:py-24"
      >
        <div class="grid gap-12 lg:grid-cols-5">
          <div class="lg:col-span-2">
            <h2
              class="text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl"
            >
              Request a repair
            </h2>
            <p class="mt-3 text-base text-zinc-600">
              Share a few details and we'll call you back to confirm a slot —
              usually within minutes.
            </p>
            <ul class="mt-8 space-y-4 text-sm text-zinc-700">
              <li class="flex items-center gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-4 shrink-0 text-zinc-900"
                >
                  <path
                    d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z"
                  ></path>
                </svg>
                Prefer to talk? Call <a
                  href={PHONE_HREF}
                  class="font-semibold text-zinc-950 hover:underline"
                  >{PHONE_DISPLAY}</a
                >
              </li>
              <li class="flex items-center gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  class="size-4 shrink-0 text-zinc-900"
                >
                  <circle cx="12" cy="12" r="8.25"></circle>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 8v4.5l3 1.75"></path>
                </svg>
                Open {SERVICE_HOURS}
              </li>
              <li class="flex items-center gap-3">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
